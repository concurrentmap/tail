<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity package sources in core/Runtime so logic can be built and
       tested from WSL without the editor. Keep LangVersion at Unity's level. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Tailed.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../core/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
